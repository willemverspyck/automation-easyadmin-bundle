{
    "name": "spyck/automation-easyadmin-bundle",
    "description": "Automation EasyAdmin Bundle for Symfony",
    "license": "MIT",
    "authors": [
        {
            "name": "Willem Verspyck",
            "email": "willemverspyck@outlook.com",
            "homepage": "https://verspyck.com",
            "role": "Developer"
        }
    ],
    "keywords": [
        "php",
        "easyadmin",
        "automation"
    ],
    "homepage": "https://github.com/willemverspyck/automation-easyadmin-bundle",
    "type": "library",
    "require": {
        "php": "^8.4",
        "easycorp/easyadmin-bundle": "^5",
        "spyck/automation-bundle": "dev-main",
        "spyck/easyadmin-extension": "dev-main",
        "symfony/http-foundation": "^7.4|^8.1"
    },
    "require-dev": {
        "escapestudios/symfony2-coding-standard": "^3",
        "friendsofphp/php-cs-fixer": "^3",
        "phpunit/phpunit": "^12",
        "squizlabs/php_codesniffer": "^3"
    },
    "autoload": {
        "psr-4": {
            "Spyck\\AutomationEasyAdminBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spyck\\AutomationEasyAdminBundle\\Tests\\": "tests/"
        }
    }
}
